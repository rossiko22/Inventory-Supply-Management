# Production image for OpenShift — TypeScript build -> Node runtime (mobile BFF).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8090
CMD ["node", "dist/index.js"]
