# Production image for OpenShift — TypeScript build -> Node runtime.
# Serves the HTTP API on 8088 and the notification WebSocket on 9091.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8088 9091
CMD ["node", "dist/main.js"]
