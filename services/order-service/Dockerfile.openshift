# Production image for OpenShift — multi-stage .NET build -> ASP.NET runtime.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY order-service.csproj .
COPY Protos ./Protos
RUN dotnet restore order-service.csproj
COPY . .
RUN dotnet publish order-service.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app .
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8087
ENV ASPNETCORE_URLS=http://+:8087
ENTRYPOINT ["dotnet", "order-service.dll"]
