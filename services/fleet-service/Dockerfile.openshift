# Production image for OpenShift — multi-stage .NET build -> ASP.NET runtime.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY fleet-service.csproj .
RUN dotnet restore fleet-service.csproj
COPY . .
RUN dotnet publish fleet-service.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app .
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8083
ENV ASPNETCORE_URLS=http://+:8083
ENTRYPOINT ["dotnet", "fleet-service.dll"]
