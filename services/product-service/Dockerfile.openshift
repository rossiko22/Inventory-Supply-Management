# Production image for OpenShift — multi-stage .NET build -> ASP.NET runtime.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY product-service.csproj .
RUN dotnet restore product-service.csproj
COPY . .
RUN dotnet publish product-service.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app .
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8085
ENV ASPNETCORE_URLS=http://+:8085
ENTRYPOINT ["dotnet", "product-service.dll"]
