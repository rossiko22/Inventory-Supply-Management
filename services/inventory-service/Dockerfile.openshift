# Production image for OpenShift — multi-stage Maven build -> slim JRE runtime.
# Exposes both the HTTP API (8086) and the gRPC server (9090) used by order-service.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn -q -B -DskipTests clean package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
RUN chgrp -R 0 /app && chmod -R g+rwX /app
EXPOSE 8086 9090
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
