{
  "name": "ai-service",
  "version": "1.0.0",
  "description": "Inventory analytics + Azure OpenAI narrative summaries",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev":   "ts-node-dev --respawn --transpile-only src/main.ts",
    "test":  "jest"
  },
  "dependencies": {
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.1",
    "express":          "^4.18.2",
    "express-rate-limit":"^7.2.0"
  },
  "devDependencies": {
    "@types/cors":      "^2.8.17",
    "@types/express":   "^4.17.21",
    "@types/jest":      "^29.5.12",
    "@types/node":      "^20.11.0",
    "@types/supertest": "^6.0.2",
    "jest":             "^29.7.0",
    "supertest":        "^7.0.0",
    "ts-jest":          "^29.1.5",
    "ts-node-dev":      "^2.0.0",
    "typescript":       "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
